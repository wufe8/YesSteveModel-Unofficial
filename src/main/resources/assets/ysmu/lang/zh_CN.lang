commands.yes_steve_model.help.title=§6§l[§aYSMU§6§l] §e指令帮助§r —— 输入 §e/ysm help <子命令>§r 查看详情
commands.yes_steve_model.help.line.reload=  §e/ysm reload§r - 重建服务端模型缓存并同步给所有玩家（OP）
commands.yes_steve_model.help.line.play=  §e/ysm play <动画名>§r - 播放当前模型的指定动画（OP）
commands.yes_steve_model.help.line.playsound=  §e/ysm playsound <名称>§r - 播放缓存的模型音效（OP）
commands.yes_steve_model.help.line.buffer=  §e/ysm buffer§r - 列出缓存的模型音效（OP）
commands.yes_steve_model.help.line.setgamepath=  §e/ysm setgamepath <路径> [版本]§r - 设置本地游戏路径（所有人）
commands.yes_steve_model.help.line.welcome=  §e/ysm welcome <on|off>§r - 开关进服欢迎消息（OP）
commands.yes_steve_model.help.line.sync=  §e/ysm sync [玩家]§r - 重同步玩家模型（OP）
commands.yes_steve_model.help.line.debug=  §e/ysm debug <query|overlay|eval>§r - 调试查询/覆盖层/求值（ADMIN）
commands.yes_steve_model.help.line.ysmlocal=  §e/ysmlocal§r - 加载本地模型，仅自己可见（所有人）
commands.yes_steve_model.help.welcome_off=  §7点击 §e[§n/ysm welcome off§e]§7 或手动输入，可关闭进服欢迎消息
commands.yes_steve_model.help.unknown=§6§l[§aYSMU§6§l] §r未知子命令：§e%s§r。输入 §e/ysm help§r 查看全部指令。
commands.yes_steve_model.help.detail.title=§6§l[§aYSMU§6§l] §e指令：§r%s
commands.yes_steve_model.help.detail.reload.usage=  语法：§e/ysm reload
commands.yes_steve_model.help.detail.reload.desc=  重建服务端模型缓存并重新同步给所有玩家。示例：§e/ysm reload
commands.yes_steve_model.help.detail.play.usage=  语法：§e/ysm play <动画名>
commands.yes_steve_model.help.detail.play.desc=  播放当前模型的指定动画（以服务器为准）。示例：§e/ysm play wave
commands.yes_steve_model.help.detail.playsound.usage=  语法：§e/ysm playsound <名称>
commands.yes_steve_model.help.detail.playsound.desc=  播放内存中缓存的某个模型音效。示例：§e/ysm playsound trident
commands.yes_steve_model.help.detail.buffer.usage=  语法：§e/ysm buffer
commands.yes_steve_model.help.detail.buffer.desc=  列出内存中缓存的模型音效。示例：§e/ysm buffer
commands.yes_steve_model.help.detail.setgamepath.usage=  语法：§e/ysm setgamepath <路径> [版本]
commands.yes_steve_model.help.detail.setgamepath.desc=  指定高版本 Minecraft 目录以加载缺失的音效/材质。仅客户端生效。示例：§e/ysm setgamepath D:\.minecraft 1.20.1
commands.yes_steve_model.help.detail.welcome.usage=  语法：§e/ysm welcome <on|off>
commands.yes_steve_model.help.detail.welcome.desc=  开关进服欢迎消息。示例：§e/ysm welcome off
commands.yes_steve_model.help.detail.sync.usage=  语法：§e/ysm sync [玩家]
commands.yes_steve_model.help.detail.sync.desc=  强制重同步指定玩家的模型（默认是自己）。示例：§e/ysm sync Steve
commands.yes_steve_model.help.detail.debug.usage=  语法：§e/ysm debug <query|overlay|eval> [args]
commands.yes_steve_model.help.detail.debug.desc=  调试工具：查询 Molang 变量、开关调试覆盖层，或对 Molang 表达式求值。示例：§e/ysm debug query q.is_on_ground，§e/ysm debug eval math.floor(3.7)
commands.yes_steve_model.help.detail.ysmlocal.usage=  语法：§e/ysmlocal
commands.yes_steve_model.help.detail.ysmlocal.desc=  注册本地扫描到的模型（config/ysmu/custom + builtin），仅自己可见。仅客户端生效。示例：§e/ysmlocal
